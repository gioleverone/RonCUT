<Window x:Class="RonCUT.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RonCUT 1.5.2 — DESIGN" Width="1500" Height="950" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F1F4F8" FontFamily="Segoe UI" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" Icon="Assets/RonCUT.ico">
 <Window.Resources>
  <Style x:Key="Tool" TargetType="Button"><Setter Property="Height" Value="60"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD9E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="#E6F2FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DBE4ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#253448"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,3"/><Setter Property="BorderBrush" Value="#CAD8E5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,3,0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Menu Grid.Row="0" FontSize="13"><MenuItem Header="_File"><MenuItem Header="_Importa SVG..." Click="Import_Click"/><Separator/><MenuItem Header="_Apri progetto..." Click="Open_Click"/><MenuItem Header="_Salva progetto" Click="Save_Click"/><MenuItem Header="Salva progetto _come..." Click="SaveAs_Click"/><Separator/><MenuItem Header="_Esporta G-code..." Click="Export_Click"/><Separator/><MenuItem Header="_Esci" Click="Exit_Click"/></MenuItem><MenuItem Header="_Impostazioni"><MenuItem Header="Impostazioni _generali..." Click="GeneralSettings_Click"/><Separator/><MenuItem Header="Modifica _utensili e supporti..." Click="Library_Click"/><MenuItem Header="Connessione e profili _CNC..." Click="CutSettings_Click"/></MenuItem><MenuItem Header="_Aiuto"><MenuItem Header="Istruzioni e limiti..." Click="Help_Click"/></MenuItem></Menu>
  <Border Grid.Row="1" Background="White" BorderBrush="#DBE4ED" BorderThickness="0,0,0,1"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#1D70BE" CornerRadius="6" Width="32" Height="32" Margin="0,0,9,0"><TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="RonCUT" FontWeight="Bold" FontSize="23" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="FileLabel" Grid.Column="1" Text="Nessun SVG importato" VerticalAlignment="Center" Foreground="#63778B"/><TextBlock Grid.Column="2" Text="DESIGN · 1.5.2" Foreground="#9B6819" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="2" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Border Background="#F9FBFD" CornerRadius="9" BorderBrush="#DDE5EE" BorderThickness="1" Padding="9" Margin="0,0,10,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ToolPanel">
    <TextBlock Text="STRUMENTI" Foreground="#788BA0" FontWeight="Bold" FontSize="11" Margin="3,3,0,9"/>
    <Button Style="{StaticResource Tool}" Tag="Seleziona" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↖" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Seleziona" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Taglio esterno" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▢" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Taglio&#x0a;esterno" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Taglio interno" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#1874C8" FontSize="26" Width="43" TextAlignment="Center"/><TextBlock Text="Taglio&#x0a;interno" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Incisione" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Incisione" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Tasca" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#1874C8" FontSize="27" Width="43" TextAlignment="Center"/><TextBlock Text="Tasca" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Foro" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⊙" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Foro" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Isole" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⊡" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Isole" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Separator Margin="2,6,2,10"/>
    <Button Style="{StaticResource Tool}" Tag="Punto zero" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#1874C8" FontSize="28" Width="43" TextAlignment="Center"/><TextBlock Text="Punto zero" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
    <Button Style="{StaticResource Tool}" Tag="Ponticelli" Click="Mode_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⊓" Foreground="#1874C8" FontSize="29" Width="43" TextAlignment="Center"/><TextBlock Text="Ponticelli" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Button>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DBE4ED" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0"><Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ModeLabel" Text="SELEZIONA" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="SizeLabel" Grid.Column="1" Text="Unità: mm   ·   griglia: 10 mm" Foreground="#76889A" FontSize="12" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Row="1" Background="#FCFDFE" BorderBrush="#DBE4ED" BorderThickness="1" ClipToBounds="True"><Canvas x:Name="Viewport" Focusable="True" Background="#FCFDFE" ClipToBounds="True" MouseWheel="Viewport_MouseWheel" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" SizeChanged="Viewport_SizeChanged"><Canvas x:Name="Drawing"><Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="Scale"/><TranslateTransform x:Name="Translate"/></TransformGroup></Canvas.RenderTransform></Canvas><Line x:Name="MeasureLine" Stroke="#E48B18" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/><Border x:Name="MeasureLabel" Background="#FFF5DC" BorderBrush="#E9B851" BorderThickness="1" CornerRadius="4" Padding="6,3" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="MeasureText" FontWeight="SemiBold"/></Border></Canvas></Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#DBE4ED" BorderThickness="1,0,1,1" CornerRadius="0,0,9,9"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Rotella: zoom   ·   Rotella premuta: sposta   ·   Tasto destro: misura" Foreground="#738497" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Adatta vista" Padding="9,2" Margin="0,5" Click="Fit_Click"/></Grid></Border>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UTENSILE E SUPPORTO" FontWeight="Bold" Foreground="#788BA0" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="Utensile"/><ComboBox x:Name="ToolCombo" DisplayMemberPath="DisplayName" SelectionChanged="Profile_Changed"/><TextBlock Text="Supporto"/><ComboBox x:Name="MaterialCombo" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/><TextBlock x:Name="ProfileLabel" TextWrapping="Wrap" FontSize="11" Foreground="#2B6B9E"/><Button Content="Modifica utensili e supporti..." Click="Library_Click" Margin="0,8,0,0" Padding="4"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PARAMETRI DEL LAVORO" FontWeight="Bold" Foreground="#788BA0" FontSize="11" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <TextBlock Text="Avanzamento Z (mm/passata)" VerticalAlignment="Center"/><TextBox x:Name="StepDownBox" Grid.Column="1"/>
      <TextBlock Grid.Row="1" Text="Avanzamento XY (mm/min)" VerticalAlignment="Center"/><TextBox x:Name="FeedXYBox" Grid.Row="1" Grid.Column="1"/>
      <TextBlock Grid.Row="2" Text="Velocità discesa Z (mm/min)" VerticalAlignment="Center"/><TextBox x:Name="FeedZBox" Grid.Row="2" Grid.Column="1"/>
      <TextBlock Grid.Row="3" Text="Passo laterale tasca (%)" VerticalAlignment="Center"/><TextBox x:Name="StepoverBox" Grid.Row="3" Grid.Column="1"/>
      <TextBlock Grid.Row="4" Text="Mandrino (giri/min)" VerticalAlignment="Center"/><TextBox x:Name="SpindleBox" Grid.Row="4" Grid.Column="1"/>
     </Grid><TextBlock Text="Tasche: passo effettivo massimo 50%." FontSize="11" Foreground="#718398"/><Button x:Name="SaveProfileButton" Content="Salva parametri per questa coppia" Click="SaveProfile_Click" Padding="4"/><Separator Margin="0,9"/><TextBlock x:Name="GeneralSummary" Text="Generali · Z sicurezza 10 mm · ponticelli 2 mm" FontSize="11" Foreground="#718398" TextWrapping="Wrap"/><Button Content="Impostazioni generali..." Click="GeneralSettings_Click" Padding="4" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LAVORAZIONI" FontWeight="Bold" Foreground="#788BA0" FontSize="11"/><TextBlock Text="Il colore indica la profondità totale." Foreground="#718398" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Ctrl/Shift: selezione multipla" FontSize="11" Foreground="#788BA0" Margin="0,4"/><Button x:Name="SelectAllOperationsButton" Content="Seleziona tutte" Click="SelectAllOperations_Click" Padding="8,4" Margin="0,0,0,6"/><Button x:Name="AddToolChangeButton" Content="Aggiungi pausa cambio utensile" ToolTip="Inserisce la pausa dopo la selezione oppure in fondo alla sequenza" Click="AddToolChange_Click" Padding="8,6" Margin="0,0,0,4"/><ListBox SelectionMode="Extended" x:Name="OperationsList" Height="115" Margin="0,7,0,5" SelectionChanged="Operation_Changed"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="▲  Su" Click="MoveUp_Click" Padding="12,4" Margin="0,0,6,0"/><Button Content="▼  Giù" Click="MoveDown_Click" Padding="12,4"/><TextBlock Text="Ordine di esecuzione" FontSize="11" Foreground="#718398" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="BatchHint" TextWrapping="Wrap" FontSize="11" Foreground="#788BA0" Margin="0,0,0,6"/><TextBlock x:Name="SelectedLabel" Text="Nessuna lavorazione selezionata" FontWeight="SemiBold" Margin="0,0,0,6"/><StackPanel x:Name="OperationDetails" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions><TextBlock Text="Profondità totale (mm)" VerticalAlignment="Center"/><TextBox x:Name="DepthBox" Grid.Column="1"/><TextBlock Grid.Row="1" Text="Altezza ponticello (mm)" VerticalAlignment="Center"/><TextBox x:Name="TabHeightBox" Grid.Row="1" Grid.Column="1"/></Grid></StackPanel><Button x:Name="EditToolChangeButton" Content="Modifica utensile dopo la pausa" Click="EditToolChange_Click" Padding="8,5" Margin="0,7,0,0" Visibility="Collapsed"/><Button x:Name="DeleteOperationsButton" Content="Elimina selezionate" Click="Delete_Click" Padding="8,5" HorizontalAlignment="Left" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel></Border>
   </StackPanel></ScrollViewer><StackPanel Grid.Row="1"><Button Content="↓   Esporta G-code" Height="43" FontSize="15" FontWeight="Bold" Background="#1971C2" Foreground="White" Click="Export_Click" Margin="0,8,0,0"/><Button Content="PASSA A CUT  ▶" Height="52" FontSize="18" FontWeight="Bold" Background="#168563" Foreground="White" Click="Cut_Click" Margin="0,8,0,0"/></StackPanel></Grid>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#DBE4ED" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Margin="16,0" VerticalAlignment="Center" Foreground="#677A90" FontSize="12" Text="Importa un SVG per iniziare."/></Border>
 </Grid>
</Window>

